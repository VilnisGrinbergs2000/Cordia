# Dependencies
node_modules/

# Build output
dist/
build/
# ...except the desktop app icon. electron-builder reads electron/build/icon.png
# and it is regenerated by client/scripts/gen-icons.mjs, so it has to be tracked
# or a fresh clone ships the default Electron icon.
!electron/build/
release/
landing/downloads/
client/public/twemoji/
.vite/
coverage/

# Runtime data & user content
server/data/
server/uploads/
uploads/
tmp/

