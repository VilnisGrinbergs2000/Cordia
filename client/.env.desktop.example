# Configuration for `npm run build:desktop`.
#
# The packaged desktop app loads the renderer from the privileged cordia://app
# scheme, so relative /api URLs cannot reach a server. Set an absolute origin.
#
# Copy this file to client/.env.desktop (gitignored) before building, or set
# CORDIA_API_URL at runtime through the Electron shell.

# Use https:// for any real deployment. Plain http only works while testing on
# the same machine.
VITE_API_URL=https://cordia.example.com

# Optional; defaults to VITE_API_URL.
# VITE_SOCKET_URL=https://cordia.example.com
