# Client build-time configuration.
#
# Vite reads these at build time and inlines them into the bundle. They are
# public values, not secrets: never put an API key, password, or token here.
#
# Copy this file to client/.env.local (gitignored) and adjust it, or export the
# variables in your shell before building. For the desktop and mobile shells,
# use .env.desktop.example and .env.mobile.example instead.

# Absolute API origin, for example https://cordia.example.com.
# Leave empty when the app is served from the same origin as the API (the
# normal web deployment, and the Vite dev proxy on localhost:5173).
# VITE_API_URL=

# Absolute Socket.IO origin, only needed when it differs from VITE_API_URL.
# Defaults to VITE_API_URL when empty.
# VITE_SOCKET_URL=
