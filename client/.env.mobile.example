# Configuration for `npm run build:mobile`.
#
# Copy this file to client/.env.mobile (gitignored) before building.
#
# The Android emulator reaches the host machine at 10.0.2.2, not localhost:
# VITE_API_URL=http://10.0.2.2:3001
#
# A physical device needs your machine's LAN address (for example
# http://192.168.1.20:3001) while the API is reachable on that interface, or a
# hosted HTTPS origin. Production builds should always use HTTPS; the native
# shell does not permit arbitrary cleartext traffic.
#
# For the iOS simulator, localhost refers to your Mac:
# VITE_API_URL=http://localhost:3001

VITE_API_URL=https://cordia.example.com

# Optional; defaults to VITE_API_URL.
# VITE_SOCKET_URL=https://cordia.example.com
