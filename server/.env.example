# Copy this file to server/.env and fill in what you need.
# server/.env is gitignored; this file is the reference for variable names.
#
# The server reads the process environment first, then fills missing values
# from this file. There is no dotenv dependency. Keep one KEY=value per line;
# an inline comment after a value is treated as part of the value.
#
# Every variable is documented in docs/configuration.md.

# --- Core ------------------------------------------------------------------
# PostgreSQL connection string. Required. The server exits at startup without it.
DATABASE_URL=postgres://cordia:password@127.0.0.1:5432/cordia

# HTTP port for the API, Socket.IO, landing page, and built client. Default 3001.
PORT=3001

# Bind address. Defaults to 127.0.0.1 so a reverse proxy is the only way in.
# Set 0.0.0.0 only when the app itself is the public listener.
# HOST=127.0.0.1

# Set to production to mark the session cookie Secure. Do not set it while
# testing over plain HTTP, or the browser will drop the cookie.
# NODE_ENV=production

# Public origin used for absolute links in mail, unsubscribe links, the sitemap,
# and IndexNow. Falls back to the request origin where there is one.
# PUBLIC_URL=https://cordia.example.com

# Comma-separated browser origins allowed by CORS and Socket.IO.
# Native origins (cordia://app, capacitor://localhost, localhost) are always
# allowed. Add every production origin, including the scheme and port.
CLIENT_ORIGIN=http://localhost:5173

# Number of reverse-proxy hops to trust for X-Forwarded-*. Set this only when a
# real proxy fronts the API; otherwise clients can spoof their IP and bypass
# per-IP rate limits. Leave commented out for direct access.
# TRUST_PROXY=1

# --- Sessions and runtime files -------------------------------------------
# HS256 secret for session and upload tokens. Leave empty to generate
# server/data/jwt.secret on first boot. Rotating it signs everyone out.
JWT_SECRET=

# Directory for generated secrets and runtime files. Default: server/data.
# CORDIA_DATA_DIR=/var/lib/cordia/data

# Directory for uploaded files. Default: server/uploads.
# Must be writable and persisted across deploys.
# CORDIA_UPLOADS_DIR=/var/lib/cordia/uploads

# --- Voice and TURN --------------------------------------------------------
# Comma-separated STUN URLs. Defaults to Google's public STUN servers.
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Comma-separated TURN URLs. TURN_URL is accepted as an alias.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp

# Shared secret for time-limited TURN credentials (coturn use-auth-secret).
# When set, TURN_URLS responses carry a fresh HMAC credential.
# TURN_SECRET=

# Static TURN credentials, used only when TURN_SECRET is empty.
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Lifetime of generated TURN credentials. Values below 300 are raised to 300.
# TURN_TTL_SECONDS=86400

# --- Web Push (VAPID) ------------------------------------------------------
# Leave both empty to generate server/data/vapid.json on first use. Set them
# explicitly to keep subscriptions stable across host rebuilds. Rotating the
# pair invalidates every existing push subscription.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@cordia.example.com

# --- Email -----------------------------------------------------------------
# Cordia queues every message in Postgres and drains it on a timer, so a mail
# server that is down delays mail instead of failing the request that sent it.
# MAIL_FROM must be an address on a domain you actually sign: without DKIM and
# SPF the big providers file it under promotions at best, spam at worst.
# MAIL_ENABLED=true
# SMTP_HOST=127.0.0.1
# SMTP_PORT=25
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=Cordia <no-reply@cordia.example.com>
# MAIL_REPLY_TO=admin@cordia.example.com
# Signs unsubscribe links in product updates. Falls back to JWT_SECRET.
# MAIL_UNSUBSCRIBE_SECRET=

# --- Integrations ----------------------------------------------------------
# KLIPY app key for the GIF tab in the emoji picker (partner.klipy.com).
# KLIPY_API_KEY is accepted as an alias. When empty, the tab is hidden.
KLIPY_KEY=

# IndexNow tells Bing, Yandex, Seznam and Naver that a page changed instead of
# waiting for the next crawl. Ownership is proved by serving /<key>.txt, so the
# key has to be reachable at PUBLIC_URL or the submission is rejected.
# INDEXNOW_KEY=

# --- Retention -------------------------------------------------------------
# Age at which audit log and report rows are deleted, and how often the
# retention pass runs. Uploads unreferenced for more than 24 hours are removed
# by the same pass.
# CORDIA_AUDIT_RETENTION_DAYS=365
# CORDIA_REPORT_RETENTION_DAYS=365
# CORDIA_PRUNE_HOURS=6

# --- Bot gateway sharding (advanced) --------------------------------------
# Only relevant when running more than one process for the bot gateway.
# Leave at the defaults for a single process, which is the supported topology.
# CORDIA_SHARD_ID=0
# CORDIA_SHARD_COUNT=1
